WEBUI_SECRET_KEY=
WEBUI_ADMIN_EMAIL=
WEBUI_ADMIN_PASSWORD=

# Required for the image MCP; also used for OpenAI chat models.
OPENAI_API_KEY=

IMAGE_MCP_API_KEY=

# OpenAI is the default chat provider. Set Ollama to True only when starting
# the optional local-llm Compose profile.
ENABLE_OPENAI_API=True
ENABLE_OLLAMA_API=False

# Image model used by the image MCP.
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
