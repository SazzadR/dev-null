# Shared settings. Keep credentials and local overrides in the root .env.
OLLAMA_BASE_URL=http://ollama:11434
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_CONFIGS='{"0": {"api_type": "responses"}}'

# Apply these settings on every restart, including existing installations.
ENABLE_PERSISTENT_CONFIG=False

# Single-quoted multiline values keep JSON readable and prevent interpolation.
TOOL_SERVER_CONNECTIONS='[
    {
        "type": "mcp",
        "url": "http://image-generation-mcp:8000/mcp",
        "path": "openapi.json",
        "auth_type": "none",
        "key": "",
        "config": {"enable": true},
        "info": {
            "id": "image_generation",
            "name": "Image Generation",
            "description": "Generate images with GPT Image"
        }
    }
]'

DEFAULT_MODEL_METADATA='{
    "capabilities": {
        "file_context": false,
        "vision": false,
        "file_upload": false,
        "web_search": false,
        "image_generation": false,
        "code_interpreter": false,
