# Copy this file to .env. Docker Compose reads .env automatically.
# Generate once with: openssl rand -hex 32
WEBUI_SECRET_KEY=
WEBUI_ADMIN_EMAIL=
WEBUI_ADMIN_PASSWORD=

# Required for the image MCP; also used for OpenAI chat models.
OPENAI_API_KEY=

# Shared bearer token used by Open WebUI to authenticate with the image MCP.
# Generate once with: openssl rand -hex 32
IMAGE_MCP_API_KEY=

# Enable OpenAI chat models in Open WebUI (independent of image generation).
ENABLE_OPENAI_API=False

# Image model used by the image MCP.
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
